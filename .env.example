# Copie para .env.local (NÃO coloque segredos neste arquivo público).
# Supabase > Project Settings > API > URL e chave PUBLICÁVEL (anon/publishable).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_AQUI

# Endereço HTTPS do HäxBag publicado na web; gera links de convites válidos
# mesmo a partir do app Electron. Sem esta URL, você pode usar convites em código,
# mas não links compartilháveis pelo app.
VITE_HAXBAG_PUBLIC_URL=https://seu-dominio-do-haxbag.com

# Configuração de TURN para a Comunicação (opcional, se já usa no site):
# VITE_HAXBAG_VOICE_ICE_URL=https://seu-servidor/credenciais-turn
